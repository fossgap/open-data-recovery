<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkListBoxRow" id="row">
    <property name="activatable">false</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">4</property>
        <property name="margin-top">10</property>
        <property name="margin-bottom">10</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <child><object class="GtkLabel" id="name"><property name="xalign">0</property><property name="wrap">true</property><property name="max-width-chars">64</property></object></child>
        <child><object class="GtkLabel" id="details"><property name="xalign">0</property><property name="wrap">true</property><property name="max-width-chars">64</property><style><class name="dim-label" /></style></object></child>
        <child><object class="GtkLabel" id="reason"><property name="xalign">0</property><property name="wrap">true</property><property name="max-width-chars">64</property><style><class name="dim-label" /></style></object></child>
      </object>
    </property>
  </object>
</interface>
