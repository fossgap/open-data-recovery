<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <object class="GtkListBoxRow" id="row">
    <style>
      <class name="source-row" />
      <class name="disk-row" />
    </style>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">9</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">8</property>
            <child>
              <object class="GtkButton" id="expand">
                <property name="icon-name">pan-down-symbolic</property>
                <style>
                  <class name="flat" />
                  <class name="disk-expander" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkImage" id="icon">
                <property name="pixel-size">20</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkLabel" id="name">
                        <property name="xalign">0</property>
                        <property name="hexpand">true</property>
                        <property name="ellipsize">end</property>
                        <style>
                          <class name="source-name" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="capacity">
                        <property name="xalign">1</property>
                        <style>
                          <class name="source-capacity" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="detail">
                    <property name="xalign">0</property>
                    <property name="ellipsize">end</property>
                    <style>
                      <class name="source-detail" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkDrawingArea" id="layout">
            <property name="content-height">12</property>
            <property name="hexpand">true</property>
            <property name="margin-start">26</property>
            <style>
              <class name="disk-map" />
            </style>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
