<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <object class="GtkWindow" id="dialog">
    <property name="title" translatable="yes">Custom scan</property>
    <property name="modal">true</property>
    <property name="default-width">680</property>
    <property name="default-height">530</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <child>
          <object class="GtkNotebook" id="options_tabs">
            <property name="vexpand">true</property>
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="min-content-height">300</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkGrid">
                    <property name="row-spacing">8</property>
                    <property name="column-spacing">12</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">8</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="valign">start</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Mode</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="mode">
                        <property name="selected">2</property>
                        <property name="hexpand">true</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>Quick</item>
                              <item>Deep</item>
                              <item>Full</item>
                            </items>
                          </object>
                        </property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Workspace</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkEntry" id="workspace">
                            <property name="placeholder-text">/media/recovery/scans</property>
                            <property name="text" />
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="browse">
                            <property name="label" translatable="yes">Browse…</property>
                          </object>
                        </child>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Extensions</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="extensions">
                        <property name="placeholder-text" translatable="yes">jpg, png, pdf, docx — empty = all</property>
                        <property name="text" />
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                        <property name="tooltip-text" translatable="yes">Extension filters constrain extraction where supported; other engines filter results. File families can include several extensions.</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Existing files</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="existing">
                        <property name="label" translatable="yes">Include existing metadata entries</property>
                        <property name="active">false</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Imaging</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="clone">
                        <property name="label" translatable="yes">Clone source before scanning</property>
                        <property name="active">false</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Linux metadata</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="capture_metadata">
                        <property name="label" translatable="yes">Capture available file metadata and links</property>
                        <property name="active">false</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Consolidation</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="consolidate">
                        <property name="label" translatable="yes">Group identical files after scanning</property>
                        <property name="active">false</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">6</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="label" translatable="yes">Scan</property>
                <property name="xalign">0</property>
                <property name="wrap">false</property>
                <property name="max-width-chars">68</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="min-content-height">300</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkGrid">
                    <property name="row-spacing">8</property>
                    <property name="column-spacing">12</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">8</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="valign">start</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Metadata engine</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuButton" id="metadata">
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">8</property>
                            <child>
                              <object class="GtkLabel" id="metadata_value">
                                <property name="label" translatable="yes">Auto</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">true</property>
                                <property name="ellipsize">end</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">pan-down-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="popover">
                          <object class="GtkPopover">
                            <property name="has-arrow">false</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="menu" />
                            </style>
                            <property name="child">
                              <object class="GtkScrolledWindow">
                                <property name="hscrollbar-policy">never</property>
                                <property name="min-content-width">200</property>
                                <property name="max-content-height">320</property>
                                <property name="propagate-natural-height">true</property>
                                <property name="child">
                                  <object class="GtkBox" id="metadata_choices">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">4</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">6</property>
                                    <property name="margin-start">6</property>
                                    <property name="margin-end">6</property>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </property>
                        <property name="tooltip-text" translatable="yes">Check one or more engines. They run in selection order. Auto uses the applicable default sequence.</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Carving engine</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuButton" id="carver">
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">8</property>
                            <child>
                              <object class="GtkLabel" id="carver_value">
                                <property name="label" translatable="yes">Auto</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">true</property>
                                <property name="ellipsize">end</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">pan-down-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="popover">
                          <object class="GtkPopover">
                            <property name="has-arrow">false</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="menu" />
                            </style>
                            <property name="child">
                              <object class="GtkScrolledWindow">
                                <property name="hscrollbar-policy">never</property>
                                <property name="min-content-width">200</property>
                                <property name="max-content-height">320</property>
                                <property name="propagate-natural-height">true</property>
                                <property name="child">
                                  <object class="GtkBox" id="carver_choices">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">4</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">6</property>
                                    <property name="margin-start">6</property>
                                    <property name="margin-end">6</property>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Clone engine</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuButton" id="clone_engine">
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">8</property>
                            <child>
                              <object class="GtkLabel" id="clone_engine_value">
                                <property name="label" translatable="yes">ddrescue</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">true</property>
                                <property name="ellipsize">end</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">pan-down-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="popover">
                          <object class="GtkPopover">
                            <property name="has-arrow">false</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="menu" />
                            </style>
                            <property name="child">
                              <object class="GtkScrolledWindow">
                                <property name="hscrollbar-policy">never</property>
                                <property name="min-content-width">200</property>
                                <property name="max-content-height">320</property>
                                <property name="propagate-natural-height">true</property>
                                <property name="child">
                                  <object class="GtkBox" id="clone_engine_choices">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">4</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">6</property>
                                    <property name="margin-start">6</property>
                                    <property name="margin-end">6</property>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="engine_context">
                        <property name="label" translatable="yes">Checking installed engines…</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">9</property>
                          <property name="column-span">2</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="label" translatable="yes">Engines</property>
                <property name="xalign">0</property>
                <property name="wrap">false</property>
                <property name="max-width-chars">68</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="min-content-height">300</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkBox" id="engine_settings">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkExpander" id="photorec_options">
                        <property name="label">PhotoRec</property>
                        <property name="child">
                          <object class="GtkGrid">
                            <property name="row-spacing">8</property>
                            <property name="column-spacing">12</property>
                            <property name="margin-top">8</property>
                            <property name="margin-bottom">8</property>
                            <property name="margin-start">8</property>
                            <property name="margin-end">8</property>
                            <property name="valign">start</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Scan area</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="photo_space">
                                <property name="selected">0</property>
                                <property name="hexpand">true</property>
                                <property name="model">
                                  <object class="GtkStringList">
                                    <items>
                                      <item>Whole selected input</item>
                                      <item>Unallocated space only</item>
                                    </items>
                                  </object>
                                </property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">JPEG recovery</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="photo_brute">
                                <property name="label" translatable="yes">Try fragmented JPEG brute force</property>
                                <property name="active">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Damaged files</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="corrupted">
                                <property name="label" translatable="yes">Keep corrupted files</property>
                                <property name="active">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Memory</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="low_memory">
                                <property name="label" translatable="yes">Use low-memory mode</property>
                                <property name="active">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Block size (bytes)</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="photo_block">
                                <property name="placeholder-text" translatable="yes">Empty = automatic</property>
                                <property name="text" />
                                <property name="hexpand">true</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">File families</property>
                                <property name="xalign">0</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">5</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="photo_families">
                                <property name="placeholder-text" translatable="yes">Empty = infer extensions; e.g. jpg, pdf, zip</property>
                                <property name="hexpand">true</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">5</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkExpander" id="ddrescue_options">
                        <property name="label" translatable="yes">ddrescue imaging</property>
                        <property name="child">
                          <object class="GtkGrid">
                            <property name="row-spacing">8</property>
                            <property name="column-spacing">12</property>
                            <property name="margin-top">8</property>
                            <property name="margin-bottom">8</property>
                            <property name="margin-start">8</property>
                            <property name="margin-end">8</property>
                            <property name="valign">start</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Retry passes</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="retries">
                                <property name="placeholder-text">0–20</property>
                                <property name="text">0</property>
                                <property name="hexpand">true</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Reads</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="dd_direct">
                                <property name="label" translatable="yes">Use direct reads (bypass cache)</property>
                                <property name="active">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Direction</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="dd_reverse">
                                <property name="label" translatable="yes">Reverse pass direction</property>
