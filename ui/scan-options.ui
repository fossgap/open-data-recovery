<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <object class="GtkWindow" id="dialog">
    <property name="title">Custom scan</property>
    <property name="modal">true</property>
    <property name="default-width">660</property>
    <property name="default-height">730</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-top">22</property>
        <property name="margin-bottom">22</property>
        <property name="margin-start">22</property>
        <property name="margin-end">22</property>
        <child>
          <object class="GtkLabel">
            <property name="label">Choose how to search.</property>
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <style>
              <class name="dialog-title" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label">Quick keeps filesystem names where possible. Deep searches file contents. Full runs both.</property>
            <property name="xalign">0</property>
            <property name="wrap">true</property>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="vexpand">true</property>
            <property name="hscrollbar-policy">never</property>
            <property name="min-content-height">420</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Scan mode</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="mode">
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>Quick · metadata</item>
                              <item>Deep · file contents</item>
                              <item>Full · metadata + file contents</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Workspace on a separate drive</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="workspace">
                        <property name="text" />
                        <property name="hexpand">true</property>
                        <property name="placeholder-text">/media/recovery/scans</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="browse">
                    <property name="label">Browse workspace…</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">File extensions (empty = all; applied to results)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="extensions">
                        <property name="text" />
                        <property name="hexpand">true</property>
                        <property name="placeholder-text">jpg, png, pdf, docx</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="existing">
                    <property name="label">Include existing files in metadata results</property>
                    <property name="active">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="clone">
                    <property name="label">Clone the source before scanning</property>
                    <property name="active">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Clone engine</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="clone_engine">
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>ddrescue</item>
                              <item>safecopy</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Clone retry passes (0–20)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="retries">
                        <property name="text">0</property>
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Metadata engine</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="metadata">
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>auto</item>
                              <item>tsk</item>
                              <item>tsk_recover</item>
                              <item>ext4magic</item>
                              <item>extundelete</item>
                              <item>ntfsundelete</item>
                              <item>recuperabit</item>
                              <item>btrfs</item>
                              <item>testdisk</item>
                              <item>ext4rescue</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Content carving engine</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="carver">
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>auto</item>
                              <item>photorec</item>
                              <item>scalpel</item>
                              <item>foremost</item>
                              <item>digler</item>
                              <item>magicrescue</item>
                              <item>recoverjpeg</item>
                              <item>bulk_extractor</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="corrupted">
                    <property name="label">PhotoRec: keep corrupted files</property>
                    <property name="active">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="low_memory">
                    <property name="label">PhotoRec: low memory mode</property>
                    <property name="active">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Minimum file size (bytes)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="minimum">
                        <property name="text">0</property>
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Maximum file size (bytes; empty = no limit)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="maximum">
                        <property name="text" />
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Source byte offset</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="offset">
                        <property name="text">0</property>
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Source byte length (empty = remainder)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="length">
                        <property name="text" />
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Engine timeout (seconds; 0 = unlimited)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="timeout">
                        <property name="text">0</property>
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">btrfs alternate tree root (byte address; optional)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="btrfs_root">
                        <property name="text" />
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">A custom byte range is copied into the workspace before scanning. Carvers search all enabled file families, then filter the recovered extensions.</property>
                    <property name="xalign">0</property>
                    <property name="wrap">true</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="validation">
            <property name="label" />
            <property name="xalign">0</property>
            <property name="wrap">true</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">10</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="close">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="confirm">
                <property name="label">Start scan</property>
                <style>
                  <class name="primary" />
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
    <style>
      <class name="recovery-window" />
    </style>
  </object>
  <object class="GtkFileChooserNative" id="chooser">
    <property name="title">Choose a folder</property>
    <property name="action">select-folder</property>
    <property name="accept-label">Choose</property>
    <property name="cancel-label">Cancel</property>
  </object>
</interface>