<?xml version='1.0' encoding='utf-8'?>
<interface>
  <object class="GtkWindow" id="dialog">
    <property name="title">Custom scan</property>
    <property name="modal">true</property>
    <property name="default-width">680</property>
    <property name="default-height">530</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <child>
          <object class="GtkNotebook" id="options_tabs">
            <property name="vexpand">true</property>
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="min-content-height">300</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkGrid">
                    <property name="row-spacing">8</property>
                    <property name="column-spacing">12</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">8</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="valign">start</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Mode</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="mode">
                        <property name="selected">2</property>
                        <property name="hexpand">true</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>Quick</item>
                              <item>Deep</item>
                              <item>Full</item>
                            </items>
                          </object>
                        </property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Workspace</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkEntry" id="workspace">
                            <property name="placeholder-text">/media/recovery/scans</property>
                            <property name="text" />
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="browse">
                            <property name="label">Browse…</property>
                          </object>
                        </child>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Extensions</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="extensions">
                        <property name="placeholder-text">jpg, png, pdf, docx — empty = all</property>
                        <property name="text" />
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Existing files</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="existing">
                        <property name="label">Include existing metadata entries</property>
                        <property name="active">false</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Imaging</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="clone">
                        <property name="label">Clone source before scanning</property>
                        <property name="active">false</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Linux metadata</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="capture_metadata">
                        <property name="label">Capture available file metadata and links</property>
                        <property name="active">false</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Consolidation</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="consolidate">
                        <property name="label">Group identical files after scanning</property>
                        <property name="active">false</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Extension filters constrain extraction where supported; other engines filter results. File families can include several extensions.</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">14</property>
                          <property name="column-span">2</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="label">Scan</property>
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="max-width-chars">68</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="min-content-height">300</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkGrid">
                    <property name="row-spacing">8</property>
                    <property name="column-spacing">12</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">8</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="valign">start</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Metadata engine</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="metadata">
                        <property name="selected">0</property>
                        <property name="hexpand">true</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>auto</item>
                              <item>tsk</item>
                              <item>tsk_recover</item>
                              <item>ext4magic</item>
                              <item>extundelete</item>
                              <item>ntfsundelete</item>
                              <item>recuperabit</item>
                              <item>btrfs</item>
                              <item>testdisk</item>
                              <item>ext4rescue</item>
                            </items>
                          </object>
                        </property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Carving engine</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="carver">
                        <property name="selected">0</property>
                        <property name="hexpand">true</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>auto</item>
                              <item>photorec</item>
                              <item>scalpel</item>
                              <item>foremost</item>
                              <item>digler</item>
                              <item>magicrescue</item>
                              <item>recoverjpeg</item>
                              <item>bulk_extractor</item>
                            </items>
                          </object>
                        </property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Clone engine</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="clone_engine">
                        <property name="selected">0</property>
                        <property name="hexpand">true</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>ddrescue</item>
                              <item>safecopy</item>
                            </items>
                          </object>
                        </property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Metadata sequence</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="metadata_sequence">
                        <property name="placeholder-text">Optional ordered engines, e.g. tsk, extundelete</property>
                        <property name="text" />
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">An explicit sequence replaces Auto. Quick uses metadata only; Deep uses one carver; Full uses both stages.</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">8</property>
                          <property name="column-span">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="engine_context">
                        <property name="label">Checking installed engines…</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">9</property>
                          <property name="column-span">2</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="label">Engines</property>
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="max-width-chars">68</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="min-content-height">300</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkBox" id="engine_settings">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkExpander" id="photorec_options">
                        <property name="label">PhotoRec</property>
                        <property name="child">
                          <object class="GtkGrid">
                            <property name="row-spacing">8</property>
                            <property name="column-spacing">12</property>
                            <property name="margin-top">8</property>
                            <property name="margin-bottom">8</property>
                            <property name="margin-start">8</property>
                            <property name="margin-end">8</property>
                            <property name="valign">start</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Scan area</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="photo_space">
                                <property name="selected">0</property>
                                <property name="hexpand">true</property>
                                <property name="model">
                                  <object class="GtkStringList">
                                    <items>
                                      <item>Whole selected input</item>
                                      <item>Unallocated space only</item>
                                    </items>
                                  </object>
                                </property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">JPEG recovery</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="photo_brute">
                                <property name="label">Try fragmented JPEG brute force</property>
                                <property name="active">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Damaged files</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="corrupted">
                                <property name="label">Keep corrupted files</property>
                                <property name="active">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Memory</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="low_memory">
                                <property name="label">Use low-memory mode</property>
                                <property name="active">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Block size (bytes)</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="photo_block">
                                <property name="placeholder-text">Empty = automatic</property>
                                <property name="text" />
                                <property name="hexpand">true</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">File families</property>
                                <property name="xalign">0</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">5</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="photo_families">
                                <property name="placeholder-text">Empty = infer extensions; e.g. jpg, pdf, zip</property>
                                <property name="hexpand">true</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">5</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkExpander" id="ddrescue_options">
                        <property name="label">ddrescue imaging</property>
                        <property name="child">
                          <object class="GtkGrid">
                            <property name="row-spacing">8</property>
                            <property name="column-spacing">12</property>
                            <property name="margin-top">8</property>
                            <property name="margin-bottom">8</property>
                            <property name="margin-start">8</property>
                            <property name="margin-end">8</property>
                            <property name="valign">start</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Retry passes</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="retries">
                                <property name="placeholder-text">0–20</property>
                                <property name="text">0</property>
                                <property name="hexpand">true</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Reads</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="dd_direct">
                                <property name="label">Use direct reads (bypass cache)</property>
                                <property name="active">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Direction</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="dd_reverse">
                                <property name="label">Reverse pass direction</property>
                                <property name="active">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Difficult regions</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="dd_scrape">
                                <property name="label">Enable scraping</property>
                                <property name="active">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Slow-read threshold (B/s)</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="dd_min_rate">
                                <property name="placeholder-text">0 = engine default</property>
                                <property name="text">0</property>
                                <property name="hexpand">true</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Maximum read rate (B/s)</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">5</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="dd_max_rate">
                                <property name="placeholder-text">0 = unlimited</property>
                                <property name="text">0</property>
                                <property name="hexpand">true</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">5</property>
                                </layout>
                              </object>
                            </child>
                            <child>
