                              <object class="GtkEntry" id="ntfs_percent">
                                <property name="placeholder-text">0–100</property>
                                <property name="text">0</property>
                                <property name="hexpand">true</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Matching</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="max-width-chars">68</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="ntfs_case">
                                <property name="label" translatable="yes">Case-sensitive filename pattern</property>
                                <property name="active">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="label" translatable="yes">Engine options</property>
                <property name="xalign">0</property>
                <property name="wrap">false</property>
                <property name="max-width-chars">68</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="min-content-height">300</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkGrid">
                    <property name="row-spacing">8</property>
                    <property name="column-spacing">12</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">8</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="valign">start</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Minimum size (bytes)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="minimum">
                        <property name="placeholder-text">0</property>
                        <property name="text">0</property>
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Maximum size (bytes)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="maximum">
                        <property name="placeholder-text" translatable="yes">Empty = unlimited</property>
                        <property name="text" />
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Source offset (bytes)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="offset">
                        <property name="placeholder-text">0</property>
                        <property name="text">0</property>
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Source length (bytes)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="length">
                        <property name="placeholder-text" translatable="yes">Empty = to end</property>
                        <property name="text" />
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Engine runtime limit (s)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="timeout">
                        <property name="placeholder-text" translatable="yes">0 = unlimited</property>
                        <property name="text">0</property>
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Filesystem interpretation</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="filesystem">
                        <property name="selected">0</property>
                        <property name="hexpand">true</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>auto</item>
                              <item>ext2</item>
                              <item>ext3</item>
                              <item>ext4</item>
                              <item>ntfs</item>
                              <item>fat12</item>
                              <item>fat16</item>
                              <item>fat32</item>
                              <item>exfat</item>
                              <item>btrfs</item>
                            </items>
                          </object>
                        </property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Sector size (bytes)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="sector_size">
                        <property name="selected">0</property>
                        <property name="hexpand">true</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>auto</item>
                              <item>512</item>
                              <item>1024</item>
                              <item>2048</item>
                              <item>4096</item>
                            </items>
                          </object>
                        </property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">TSK directory inode</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">7</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="directory_inode">
                        <property name="placeholder-text" translatable="yes">Empty = filesystem root</property>
                        <property name="text" />
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">7</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">A custom source range is retained in the workspace. Overrides are recorded and reused for recovery.</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">16</property>
                          <property name="column-span">2</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="label" translatable="yes">Advanced</property>
                <property name="xalign">0</property>
                <property name="wrap">false</property>
                <property name="max-width-chars">68</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="validation">
            <property name="label" />
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <property name="max-width-chars">68</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">8</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="close">
                <property name="label" translatable="yes">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="confirm">
                <property name="label" translatable="yes">Start scan</property>
                <style>
                  <class name="suggested-action" />
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
  <object class="GtkFileChooserNative" id="chooser">
    <property name="title" translatable="yes">Choose workspace</property>
    <property name="action">select-folder</property>
    <property name="accept-label" translatable="yes">Choose</property>
    <property name="cancel-label" translatable="yes">Cancel</property>
  </object>
</interface>
