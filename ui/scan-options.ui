                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Source offset (bytes)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="offset">
                        <property name="placeholder-text">0</property>
                        <property name="text">0</property>
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Source length (bytes)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="length">
                        <property name="placeholder-text">Empty = to end</property>
                        <property name="text" />
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Engine runtime limit (s)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="timeout">
                        <property name="placeholder-text">0 = unlimited</property>
                        <property name="text">0</property>
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Filesystem interpretation</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="filesystem">
                        <property name="selected">0</property>
                        <property name="hexpand">true</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>auto</item>
                              <item>ext2</item>
                              <item>ext3</item>
                              <item>ext4</item>
                              <item>ntfs</item>
                              <item>fat12</item>
                              <item>fat16</item>
                              <item>fat32</item>
                              <item>exfat</item>
                              <item>btrfs</item>
                            </items>
                          </object>
                        </property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Sector size (bytes)</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="sector_size">
                        <property name="selected">0</property>
                        <property name="hexpand">true</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>auto</item>
                              <item>512</item>
                              <item>1024</item>
                              <item>2048</item>
                              <item>4096</item>
                            </items>
                          </object>
                        </property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">TSK directory inode</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">7</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="directory_inode">
                        <property name="placeholder-text">Empty = filesystem root</property>
                        <property name="text" />
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">7</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">A custom source range is retained in the workspace. Overrides are recorded and reused for recovery.</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">68</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">16</property>
                          <property name="column-span">2</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="label">Advanced</property>
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="max-width-chars">68</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="plan_view">
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <property name="visible">false</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkLabel" id="plan_heading">
                <property name="label">Scan plan</property>
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="max-width-chars">68</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="vexpand">true</property>
                <property name="min-content-height">300</property>
                <property name="hscrollbar-policy">never</property>
                <property name="child">
                  <object class="GtkLabel" id="plan_summary">
                    <property name="label" />
                    <property name="xalign">0</property>
                    <property name="wrap">true</property>
                    <property name="max-width-chars">68</property>
                    <property name="selectable">true</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="validation">
            <property name="label" />
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <property name="max-width-chars">68</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">8</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="close">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="back">
                <property name="label">Back</property>
                <property name="visible">false</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="confirm">
                <property name="label">Next</property>
                <style>
                  <class name="suggested-action" />
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
  <object class="GtkFileChooserNative" id="chooser">
    <property name="title">Choose workspace</property>
    <property name="action">select-folder</property>
    <property name="accept-label">Choose</property>
    <property name="cancel-label">Cancel</property>
  </object>
</interface>
