<?xml version='1.0' encoding='utf-8'?>
<interface>
  <object class="GtkStringList" id="destinations">
    <items>
      <item>Choose a sample destination…</item>
      <item>Recovery drive · /media/recovery · 2.0 TiB free</item>
      <item>Source drive · same source device</item>
      <item>Unverified drive · identity unavailable</item>
    </items>
  </object>
  <object class="GtkWindow" id="dialog">
    <property name="title">Review recovery</property>
    <property name="modal">true</property>
    <property name="resizable">false</property>
    <property name="default-width">530</property>
    <style>
      <class name="recovery-window" />
    </style>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">18</property>
        <style>
          <class name="dialog-content" />
        </style>
        <child>
          <object class="GtkLabel">
            <property name="label">A new home for your files.</property>
            <property name="xalign">0</property>
            <style>
              <class name="dialog-title" />
              <class name="heading" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="summary">
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <style>
              <class name="dialog-copy" />
              <class name="dim-label" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>
            <style>
              <class name="dialog-card" />
            </style>
            <child>
              <object class="GtkDropDown" id="destination">
                <property name="model">destinations</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Destination folder</property>
                    <property name="xalign">0</property>
                    <property name="wrap">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkEntry" id="destination_path">
                        <property name="text" />
                        <property name="hexpand">true</property>
                        <property name="placeholder-text">/media/recovery/restored</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="browse">
                        <property name="label">Browse destination…</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="validation">
                <property name="label">Choose where to save recovered files.</property>
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="max-width-chars">55</property>
                <style>
                  <class name="dialog-copy" />
                  <class name="dim-label" />
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="recovery_options">
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>
            <child>
              <object class="GtkCheckButton" id="all_paths">
                <property name="label">Recover every recorded path</property>
                <property name="active">false</property>
                <property name="visible">false</property>
                <property name="tooltip-text">Normally one copy is recovered per consolidated group. Enable to restore each distinct recorded path, including alternate names from other engines. This writes more copies and needs additional destination space.</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="preserve_tree">
                <property name="label">Preserve folder structure</property>
                <property name="active">true</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">If a filename already exists</property>
                    <property name="xalign">0</property>
                    <property name="wrap">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="conflict">
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>Rename the recovered file</item>
                          <item>Skip the recovered file</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="timestamps">
                <property name="label">Preserve modification timestamps</property>
                <property name="active">true</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="linux_metadata">
                <property name="label">Preserve Linux file metadata, links and sparse layout</property>
                <property name="tooltip-text">Restore available captured file metadata. Unsupported permissions or attributes are reported in the recovery log.</property>
                <property name="active">false</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="verify">
                <property name="label">Verify SHA-256 after writing</property>
                <property name="active">true</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="continue_errors">
                <property name="label">Continue after individual file errors</property>
                <property name="active">true</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="notice">
            <property name="label">This is a simulation. Destination identity and free space are sample data. No directories or recovered files will be created.</property>
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <property name="max-width-chars">58</property>
            <style>
              <class name="dialog-warning" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="result">
            <property name="visible">false</property>
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <property name="max-width-chars">58</property>
            <style>
              <class name="success" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">10</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="close">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="confirm">
                <property name="label">Simulate recovery</property>
                <property name="sensitive">false</property>
                <style>
                  <class name="suggested-action" />
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
  <object class="GtkFileChooserNative" id="chooser">
    <property name="title">Choose a folder</property>
    <property name="action">select-folder</property>
    <property name="accept-label">Choose</property>
    <property name="cancel-label">Cancel</property>
  </object>
</interface>
