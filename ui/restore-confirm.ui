<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.8" />
  <object class="GtkWindow" id="dialog">
    <property name="title" translatable="yes">Confirm disk restoration</property>
    <property name="modal">true</property>
    <property name="default-width">560</property>
    <property name="default-widget">close</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">16</property>
        <property name="margin-top">20</property>
        <property name="margin-bottom">20</property>
        <property name="margin-start">20</property>
        <property name="margin-end">20</property>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">Overwrite this disk?</property>
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <style><class name="title-2" /></style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="details">
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <property name="wrap-mode">word-char</property>
            <property name="max-width-chars">62</property>
            <property name="selectable">true</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">All existing data on the target disk will be lost. This cannot be undone.</property>
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <property name="max-width-chars">62</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="halign">end</property>
            <property name="spacing">8</property>
            <child><object class="GtkButton" id="close"><property name="label" translatable="yes">Cancel</property></object></child>
            <child>
              <object class="GtkButton" id="confirm">
                <property name="label" translatable="yes">Overwrite disk and restore</property>
                <style><class name="destructive-action" /></style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
