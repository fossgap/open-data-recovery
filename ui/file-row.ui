<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <object class="GtkListBoxRow" id="row">
    <style>
      <class name="file-row" />
    </style>
    <property name="child">
      <object class="GtkBox">
        <property name="spacing">10</property>
        <child>
          <object class="GtkCheckButton" id="check">
            <property name="tooltip-text">Select file for recovery</property>
          </object>
        </child>
        <child>
          <object class="GtkImage" id="icon">
            <property name="margin-start">24</property>
            <property name="pixel-size">17</property>
            <style>
              <class name="file-icon" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="name">
            <property name="xalign">0</property>
            <property name="hexpand">true</property>
            <property name="ellipsize">middle</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="size">
            <property name="width-request">78</property>
            <property name="xalign">1</property>
            <style>
              <class name="muted" />
              <class name="dim-label" />
              <class name="numeric" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="status">
            <property name="width-request">100</property>
            <property name="xalign">0</property>
            <style>
              <class name="discovery" />
            </style>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>