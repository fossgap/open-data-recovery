<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkWindow" id="dialog">
    <property name="title" translatable="yes">Delete saved scan?</property>
    <property name="modal">true</property>
    <property name="default-width">560</property>
    <property name="resizable">false</property>
    <property name="default-widget">close</property>
    <property name="child"><object class="GtkBox">
      <property name="orientation">vertical</property>
      <property name="spacing">16</property>
      <property name="margin-top">20</property>
      <property name="margin-bottom">20</property>
      <property name="margin-start">20</property>
      <property name="margin-end">20</property>
      <child><object class="GtkLabel">
        <property name="label" translatable="yes">Permanently delete this saved scan?</property>
        <property name="xalign">0</property>
        <style><class name="heading" /></style>
      </object></child>
      <child><object class="GtkLabel" id="details">
        <property name="xalign">0</property><property name="wrap">true</property>
        <property name="max-width-chars">65</property><property name="selectable">true</property>
      </object></child>
      <child><object class="GtkLabel">
        <property name="label" translatable="yes">This removes the entire folder, including scan results, selections, logs, extracted files, caches and any retained clone. It cannot be undone.&#10;&#10;The original source and recovered files outside this folder are kept.</property>
        <property name="xalign">0</property><property name="wrap">true</property><property name="max-width-chars">65</property>
      </object></child>
      <child><object class="GtkLabel" id="validation">
        <property name="xalign">0</property><property name="wrap">true</property><property name="max-width-chars">65</property>
      </object></child>
      <child><object class="GtkBox">
        <property name="halign">end</property><property name="spacing">8</property>
        <child><object class="GtkButton" id="close"><property name="label" translatable="yes">Cancel</property></object></child>
        <child><object class="GtkButton" id="confirm">
          <property name="label" translatable="yes">Delete saved scan</property>
          <style><class name="destructive-action" /></style>
        </object></child>
      </object></child>
    </object></property>
  </object>
</interface>
