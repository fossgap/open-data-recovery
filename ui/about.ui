<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.8" />
  <object class="GtkAboutDialog" id="about">
    <property name="program-name">Open Data Recovery</property>
    <property name="title" translatable="yes">About Open Data Recovery</property>
    <property name="comments" translatable="yes">Native Linux data recovery with read-only sources and persistent scan sessions.</property>
    <property name="website-label" translatable="yes">Project website</property>
    <property name="license-type">gpl-3-0-only</property>
    <property name="wrap-license">true</property>
    <property name="modal">true</property>
    <property name="destroy-with-parent">true</property>
    <property name="hide-on-close">true</property>
  </object>
</interface>
